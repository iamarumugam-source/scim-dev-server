# ── scim-dev-server secret values ────────────────────────────────────────────
# 1. Copy this file:  cp k8s/env.template .env.k8s.local
# 2. Fill in every value below (the file is already gitignored via .env*)
# 3. Run:             make secrets
#
# `make secrets` is idempotent — safe to re-run after any value changes.
# Comments and blank lines are stripped by kubectl before creating the Secret.
# ─────────────────────────────────────────────────────────────────────────────

# NextAuth signing secret — generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Okta OAuth app client secret (from Okta Admin → Applications → your app)
OKTA_CLIENT_SECRET=

# PostgreSQL password — pick anything, used for the in-cluster postgres pod.
# Must match the password portion of POSTGRES_URL below.
POSTGRES_PASSWORD=

# Full connection URL.  The hostname 'postgres' is the in-cluster Service name.
# Replace YOURPASSWORD with the same value you set in POSTGRES_PASSWORD above.
POSTGRES_URL=postgresql://postgres:YOURPASSWORD@postgres:5432/scim_dev

# Cloudflare Tunnel token
# Zero Trust → Networks → Tunnels → <your tunnel> → Configure → Token
CF_TUNNEL_TOKEN=

# LLM API key (used by the AI template-generator endpoint)
LLM_API_KEY=
